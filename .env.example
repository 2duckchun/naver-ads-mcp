# 네이버 검색광고 > 도구 > API 사용 관리에서 발급
# https://manage.searchad.naver.com

# 액세스라이선스
NAVER_SA_API_KEY=
# 비밀키
NAVER_SA_SECRET_KEY=
# CUSTOMER_ID (광고계정 ID, 숫자)
NAVER_SA_CUSTOMER_ID=

# --- 이하 선택 ---
# API 베이스 URL
NAVER_SA_BASE_URL=https://api.searchad.naver.com
# 요청 타임아웃(ms)
NAVER_SA_TIMEOUT_MS=15000
# 429/5xx 재시도 횟수
NAVER_SA_MAX_RETRIES=2
