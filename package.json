{
  "name": "naver-ads-mcp",
  "packageManager": "pnpm@10.8.1",
  "version": "0.1.0",
  "description": "네이버 검색광고 API를 감싼 stdio MCP 서버 (Naver Search Ad API MCP server)",
  "type": "module",
  "bin": {
    "naver-ads-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "2duckchun <kkts9308@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2duckchun/naver-ads-mcp.git"
  },
  "homepage": "https://github.com/2duckchun/naver-ads-mcp#readme",
  "bugs": {
    "url": "https://github.com/2duckchun/naver-ads-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "naver",
    "naver-ads",
    "searchad",
    "네이버",
    "검색광고",
    "advertising",
    "claude"
  ],
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
